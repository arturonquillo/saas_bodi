  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  portal   Portal       @relation(fields: [portalId], references: [id], onDelete: Cascade)
  category HelpCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  author   User         @relation("ArticleAuthor", fields: [authorUserId], references: [id], onDelete: Cascade)

  @@unique([portalId, slug])
  @@index([portalId, status])
  @@index([tenantId, categoryId])
  @@map("articles")
}

model Orcamento {
  id                String           @id
  tenantId          String           @map("tenant_id")
  clienteId         String?          @map("cliente_id")
  cadastroRequestId String?          @map("cadastro_request_id")
  vendedorUserId    String           @map("vendedor_user_id")
  status            OrcamentoStatus
  validoAte         DateTime?        @map("valido_ate")
  channel           OrcamentoChannel
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente         Cliente?                 @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  cadastroRequest CadastroRequest?         @relation(fields: [cadastroRequestId], references: [id], onDelete: SetNull)
  vendedor        User                     @relation("OrcamentoVendedor", fields: [vendedorUserId], references: [id])
  pedido          PedidoVenda?             @relation("PedidoFromOrcamento")
  lines           OrcamentoLine[]
  history         OrcamentoStatusHistory[]
  outbox          NotificationOutbox[]
  conversations   Conversation[]

  @@index([tenantId, status])
  @@index([tenantId, clienteId])
  @@map("orcamentos")
}

model OrcamentoLine {
  id                String  @id
  tenantId          String  @map("tenant_id")
  orcamentoId       String  @map("orcamento_id")
  skuId             String  @map("sku_id")
  codigoSnapshot    String  @map("codigo_snapshot")
  nomeSnapshot      String  @map("nome_snapshot")
  qty               Int
  unitPriceCentavos Int     @map("unit_price_centavos")
  notas             String?

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  sku       Sku       @relation(fields: [skuId], references: [id])

  @@index([tenantId, orcamentoId])
  @@map("orcamento_lines")
}

model OrcamentoStatusHistory {
  id          String          @id
  tenantId    String          @map("tenant_id")
  orcamentoId String          @map("orcamento_id")
  fromStatus  String?         @map("from_status")
  toStatus    OrcamentoStatus @map("to_status")
  actorUserId String?         @map("actor_user_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  orcamento Orcamento @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, orcamentoId, createdAt])
  @@map("orcamento_status_histories")
}

model PedidoVenda {
  id             String        @id
  tenantId       String        @map("tenant_id")
  clienteId      String        @map("cliente_id")
  vendedorUserId String        @map("vendedor_user_id")
  orcamentoId    String?       @unique @map("orcamento_id")
  channel        PedidoChannel
  status         PedidoStatus
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente   Cliente               @relation(fields: [clienteId], references: [id])
  vendedor  User                  @relation("PedidoVendedor", fields: [vendedorUserId], references: [id])
  orcamento Orcamento?            @relation("PedidoFromOrcamento", fields: [orcamentoId], references: [id], onDelete: SetNull)
  lines     PedidoLine[]
  history   PedidoStatusHistory[]
  vendas    VendaFaturamento[]
  outbox    NotificationOutbox[]
  movements InventoryMovement[]

  @@index([tenantId, status])
  @@index([tenantId, clienteId])
  @@map("pedidos_venda")
}

model PedidoLine {
  id                String @id
  tenantId          String @map("tenant_id")
  pedidoId          String @map("pedido_id")
  skuId             String @map("sku_id")
  codigoSnapshot    String @map("codigo_snapshot")
  nomeSnapshot      String @map("nome_snapshot")
  qty               Int
  unitPriceCentavos Int    @map("unit_price_centavos")

  pedido PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  sku    Sku         @relation(fields: [skuId], references: [id])

  @@index([tenantId, pedidoId])
  @@map("pedido_lines")
}

model PedidoStatusHistory {
  id          String       @id
  tenantId    String       @map("tenant_id")
  pedidoId    String       @map("pedido_id")
  fromStatus  String?      @map("from_status")
  toStatus    PedidoStatus @map("to_status")
  actorUserId String?      @map("actor_user_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  pedido PedidoVenda @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  actor  User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, pedidoId, createdAt])
  @@map("pedido_status_histories")
}

model VendaFaturamento {
  id              String      @id
  tenantId        String      @map("tenant_id")
  pedidoId        String      @map("pedido_id")
  status          VendaStatus
  createdByUserId String      @map("created_by_user_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pedido    PedidoVenda          @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  createdBy User                 @relation("VendaCreator", fields: [createdByUserId], references: [id])
  history   VendaStatusHistory[]
  outbox    NotificationOutbox[]

  @@index([tenantId, status])
  @@index([tenantId, pedidoId])
  @@map("vendas_faturamento")
}

model VendaStatusHistory {
  id          String      @id
  tenantId    String      @map("tenant_id")
  vendaId     String      @map("venda_id")
  fromStatus  String?     @map("from_status")
  toStatus    VendaStatus @map("to_status")
  actorUserId String?     @map("actor_user_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  venda VendaFaturamento @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  actor User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, vendaId, createdAt])
  @@map("venda_status_histories")
}

model Sku {
  id                   String  @id
  tenantId             String  @map("tenant_id")
  codigo               String
  nome                 String
  precoAtacadoCentavos Int     @map("preco_atacado_centavos")
  qtdMinAtacado        Int     @default(1) @map("qtd_min_atacado")
  visivelLoja          Boolean @default(true) @map("visivel_loja")

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balance        InventoryBalance?
  movements      InventoryMovement[]
  orcamentoLines OrcamentoLine[]
  pedidoLines    PedidoLine[]

  @@unique([tenantId, codigo])
  @@index([tenantId, visivelLoja])
  @@map("skus")
}

/// The only inventory ledger. Loja stock is a projection of this row + visivel_loja.
model InventoryBalance {
  skuId    String @id @map("sku_id")
  tenantId String @map("tenant_id")
  onHand   Int    @default(0) @map("on_hand")
  reserved Int    @default(0)

  sku    Sku    @relation(fields: [skuId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("inventory_balances")
}

model InventoryMovement {
  id            String       @id
  tenantId      String       @map("tenant_id")
  skuId         String       @map("sku_id")
  pedidoId      String?      @map("pedido_id")
  type          MovementType
  deltaOnHand   Int          @map("delta_on_hand")
  deltaReserved Int          @map("delta_reserved")
  reason        String?
  actorUserId   String?      @map("actor_user_id")
  createdAt     DateTime     @default(now()) @map("created_at")

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku    Sku          @relation(fields: [skuId], references: [id], onDelete: Cascade)
  pedido PedidoVenda? @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  actor  User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, skuId, createdAt])
  @@map("inventory_movements")
}

model NotificationOutbox {
  id                String              @id
  tenantId          String              @map("tenant_id")
  channel           OutboxChannel
  recipientRole     OutboxRecipientRole @map("recipient_role")
  recipient         String
  templateKey       String              @map("template_key")
  category          OutboxCategory      @default(commerce)
  campaignId        String?             @map("campaign_id")
  payloadJson       String              @map("payload_json")
  status            OutboxStatus        @default(pendente)
  orcamentoId       String?             @map("orcamento_id")
  pedidoId          String?             @map("pedido_id")
  vendaId           String?             @map("venda_id")
  cadastroRequestId String?             @map("cadastro_request_id")
  conversationId    String?             @map("conversation_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orcamento       Orcamento?        @relation(fields: [orcamentoId], references: [id], onDelete: SetNull)
  pedido          PedidoVenda?      @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  venda           VendaFaturamento? @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  cadastroRequest CadastroRequest?  @relation(fields: [cadastroRequestId], references: [id], onDelete: SetNull)
  conversation    Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  campaign        Campaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, category, status])
  @@index([tenantId, campaignId])
  @@map("notification_outbox")
}

model Session {
  id        String   @id
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  surface   Surface
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@map("sessions")
}

// --- Phase E enterprise & AI ---

model SlaPolicy {
  id          String   @id
  tenantId    String   @map("tenant_id")
  name        String
  frtSeconds  Int      @map("frt_seconds")
  nrtSeconds  Int      @map("nrt_seconds")
  rtSeconds   Int      @map("rt_seconds")
  active      Boolean  @default(true)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultForInboxes  Inbox[]          @relation("InboxDefaultSla")
  conversations      Conversation[]   @relation("ConversationSlaPolicy")
  conversationSlas   ConversationSla[]

  @@index([tenantId, active])
  @@map("sla_policies")
}

model ConversationSla {
  id             String    @id
  tenantId       String    @map("tenant_id")
  conversationId String    @unique @map("conversation_id")
  slaPolicyId    String    @map("sla_policy_id")
  frtDueAt       DateTime  @map("frt_due_at")
  nrtDueAt       DateTime? @map("nrt_due_at")
  rtDueAt        DateTime  @map("rt_due_at")
  frtHitAt       DateTime? @map("frt_hit_at")
  nrtHitAt       DateTime? @map("nrt_hit_at")
  rtHitAt        DateTime? @map("rt_hit_at")
  frtBreached    Boolean   @default(false) @map("frt_breached")
  nrtBreached    Boolean   @default(false) @map("nrt_breached")
  rtBreached     Boolean   @default(false) @map("rt_breached")
  appliedAt      DateTime  @default(now()) @map("applied_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  slaPolicy    SlaPolicy    @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)

  @@index([tenantId, frtDueAt])
  @@map("conversation_slas")
}

model AgentCapacity {
  id                    String   @id
  tenantId              String   @map("tenant_id")
  userId                String   @map("user_id")
  maxOpenConversations  Int      @map("max_open_conversations")
  updatedAt             DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("agent_capacities")
}

model CaptainAssistant {
  id               String   @id
  tenantId         String   @map("tenant_id")
  name             String
  mode             String
  systemPromptStub String?  @map("system_prompt_stub")
  active           Boolean  @default(true)
  configJson       String?  @map("config_json")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  suggestions CaptainSuggestion[]

  @@index([tenantId, active])
  @@map("captain_assistants")
}

model CaptainSuggestion {
  id               String    @id
  tenantId         String    @map("tenant_id")
  conversationId   String    @map("conversation_id")
  assistantId      String?   @map("assistant_id")
  mode             String
  status           String    @default("pending")
  proposalJson     String    @map("proposal_json")
  createdBy        String    @default("agent") @map("created_by")
  actorUserId      String?   @map("actor_user_id")
  resolvedByUserId String?   @map("resolved_by_user_id")
  resolvedAt       DateTime? @map("resolved_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assistant    CaptainAssistant? @relation(fields: [assistantId], references: [id], onDelete: SetNull)
  actor        User?             @relation("CaptainSuggestionActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?             @relation("CaptainSuggestionResolver", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, conversationId, status])
  @@map("captain_suggestions")
}

model AuditEvent {
  id            String   @id
  tenantId      String   @map("tenant_id")
  actorUserId   String?  @map("actor_user_id")
  action        String
  aggregateType String   @map("aggregate_type")
  aggregateId   String   @map("aggregate_id")
  payloadJson   String   @default("{}") @map("payload_json")
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, action, createdAt])
  @@map("audit_events")
}

model SamlConfig {
  id                       String   @id
  tenantId                 String   @unique @map("tenant_id")
  enabled                  Boolean  @default(false)
  idpEntityId              String?  @map("idp_entity_id")
  idpSsoUrl                String?  @map("idp_sso_url")
  idpCertificateCiphertext String?  @map("idp_certificate_ciphertext")
  spEntityId               String?  @map("sp_entity_id")
  jitProvision             Boolean  @default(false) @map("jit_provision")
  updatedAt                DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("saml_configs")
}

model MfaDevice {
  id                    String    @id
  tenantId              String    @map("tenant_id")
  userId                String    @map("user_id")
  secretCiphertext      String    @map("secret_ciphertext")
  enabled               Boolean   @default(false)
  recoveryCodesHashJson String    @default("[]") @map("recovery_codes_hash_json")
  confirmedAt           DateTime? @map("confirmed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("mfa_devices")
}

model CustomRole {
  id              String   @id
  tenantId        String   @map("tenant_id")
  name            String
  description     String?
  permissionsJson String   @default("[]") @map("permissions_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@unique([tenantId, name])
  @@map("custom_roles")
}

model IntegrationInstall {
  id                  String   @id
  tenantId            String   @map("tenant_id")
  provider            String
  connectionStatus    String   @default("not_configured") @map("connection_status")
  metadataJson        String?  @map("metadata_json")
  secretsCiphertext   String?  @map("secrets_ciphertext")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdAt           DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@map("integration_installs")
}

model DashboardApp {
  id           String   @id
  tenantId     String   @map("tenant_id")
  title        String
  url          String
  enabled      Boolean  @default(true)
  inboxIdsJson String?  @map("inbox_ids_json")
  position     Int      @default(0)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, enabled])
  @@map("dashboard_apps")
}
