model Conversation {
  id                   String                @id
  tenantId             String                @map("tenant_id")
  inboxId              String                @map("inbox_id")
  contactId            String                @map("contact_id")
  status               ConversationStatus    @default(open)
  priority             ConversationPriority?
  assigneeUserId       String?               @map("assignee_user_id")
  teamId               String?               @map("team_id")
  snoozedUntil         DateTime?             @map("snoozed_until")
  muted                Boolean               @default(false)
  clienteId            String?               @map("cliente_id")
  cadastroRequestId    String?               @map("cadastro_request_id")
  orcamentoId          String?               @map("orcamento_id")
  customAttributesJson String                @default("{}") @map("custom_attributes_json")
  botAgentBotId        String?               @map("bot_agent_bot_id")
  csatToken            String?               @unique @map("csat_token")
  csatSentAt           DateTime?             @map("csat_sent_at")
  slaPolicyId          String?               @map("sla_policy_id")
  lastActivityAt       DateTime              @default(now()) @map("last_activity_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox           Inbox                 @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact         Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignee        User?                 @relation("ConversationAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  team            Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  cliente         Cliente?              @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  cadastroRequest CadastroRequest?      @relation("ConversationCadastro", fields: [cadastroRequestId], references: [id], onDelete: SetNull)
  orcamento       Orcamento?            @relation(fields: [orcamentoId], references: [id], onDelete: SetNull)
  botAgentBot     AgentBot?             @relation(fields: [botAgentBotId], references: [id], onDelete: SetNull)
  slaPolicy       SlaPolicy?            @relation("ConversationSlaPolicy", fields: [slaPolicyId], references: [id], onDelete: SetNull)
  conversationSla ConversationSla?
  captainSuggestions CaptainSuggestion[]
  messages        Message[]
  labels          ConversationLabel[]
  drafts          ConversationDraft[]
  notifications   AgentNotification[]
  presences       AgentPresence[]
  outbox          NotificationOutbox[]
  cadastrosFromConversation CadastroRequest[] @relation("CadastroConversation")
  csatResponses   CsatResponse[]

  @@index([tenantId, status, lastActivityAt])
  @@index([tenantId, assigneeUserId])
  @@index([tenantId, inboxId])
  @@index([tenantId, contactId])
  @@index([tenantId, botAgentBotId])
  @@index([tenantId, slaPolicyId])
  @@map("conversations")
}

