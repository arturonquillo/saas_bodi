      "alt": "Casa dos Frios",
      "slot": "header and hero — square or wide SVG/PNG when supplied"
    },
    "color": {
      "marca": "#7A1F1F",
      "primary": "#7A1F1F",
      "accent": "#1F5C6B",
      "background": "#EEF2F4",
      "text": "#141A1F",
      "textMuted": "#5A6570",
      "textOnPrimary": "#F7F1F0",
      "textOnAccent": "#F2F8FA",
      "surface": "#F7F9FA",
