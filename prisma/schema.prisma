generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CanalAviso {
  email
  whatsapp
  ambos
}

enum LojaModo {
  pedido_direto
  orcamento
}

enum SaasRole {
  admin
  vendedor
}

enum Surface {
  loja
  saas
}

enum CadastroStatus {
  pendente
  aprovado
  recusado
}

enum CadastroSource {
  loja
  whatsapp
  saas
}

enum ClienteStatus {
  aprovado
}

enum OrcamentoStatus {
  rascunho
  enviado
  aceito
  recusado
  expirado
  cancelado
}

enum OrcamentoChannel {
  saas
  whatsapp
  loja
}

enum PedidoStatus {
  confirmado
  em_separacao
  despachado
  entregue
  cancelado
}

enum PedidoChannel {
  loja
  saas
  orcamento
}

enum VendaStatus {
  rascunho
  faturado
  cancelado
}

enum MovementType {
  reserve
  release
  consume
  adjust
}

enum OutboxChannel {
  email
  whatsapp
  sms
}

enum OutboxRecipientRole {
  customer
  vendedor
  agent
}

enum OutboxStatus {
  pendente
  enviado
  falha
}

enum OutboxCategory {
  commerce
  campaign
  crm_agent
  csat
  agent_email
}

enum ChannelType {
  whatsapp
  web_widget
  email
  facebook
  instagram
  tiktok
  twitter
  telegram
  line
  sms
  api
  voice
}

enum WaConnectionStatus {
  not_configured
  credentials_saved
  ready_stub
  live
}

enum WaProvider {
  whatsapp_cloud
  default
}

enum ConversationStatus {
  open
  pending
  snoozed
  resolved
}

enum ConversationPriority {
  low
  medium
  high
  urgent
}

enum MessageType {
  incoming
  outgoing
  activity
}

enum MessageContentType {
  text
  attachment
  input_select
  cards
  form
}

enum MessageDeliveryStatus {
  queued
  sent
  delivered
  read
  failed
}

enum AgentAvailability {
  online
  busy
  offline
}

enum PresenceState {
  viewing
  typing
  online
  busy
  offline
}

enum BackgroundJobStatus {
  pendente
  processando
  concluido
  falha
  morto
}

model Tenant {
  id                    String     @id
  slug                  String     @unique
  razaoSocial           String     @map("razao_social")
  nomeFantasia          String     @map("nome_fantasia")
  cnpjDigits            String     @map("cnpj_digits")
  cnpjLast4             String     @map("cnpj_last4")
  whatsappComercial     String?    @map("whatsapp_comercial")
  canaisAviso           CanalAviso @default(whatsapp) @map("canais_aviso")
  lojaModo              LojaModo   @default(pedido_direto) @map("loja_modo")
  defaultVendedorUserId String?    @map("default_vendedor_user_id")
  webhookSigningSecret  String?    @map("webhook_signing_secret")
  mfaRequired           Boolean    @default(false) @map("mfa_required")
  createdAt             DateTime   @default(now()) @map("created_at")

  theme                 Theme?
  memberships           Membership[]
  cadastroRequests      CadastroRequest[]
  clientes              Cliente[]
  companies             Company[]
  contacts              Contact[]
  contactInboxes        ContactInbox[]
  inboxes               Inbox[]
  channelWhatsapps      ChannelWhatsapp[]
  channelWebsiteWidgets ChannelWebsiteWidget[]
  channelEmails         ChannelEmail[]
  channelSocials        ChannelSocial[]
  channelSmses          ChannelSms[]
  channelApis           ChannelApi[]
  channelVoices         ChannelVoice[]
  widgetSessions        WidgetSession[]
  emailTemplates        EmailTemplate[]
  pushSubscriptions     PushSubscription[]
  inboxMembers          InboxMember[]
  conversations         Conversation[]
  messages              Message[]
  labels                Label[]
  conversationLabels    ConversationLabel[]
  contactLabels         ContactLabel[]
  teams                 Team[]
  teamMembers           TeamMember[]
  cannedResponses       CannedResponse[]
  agentNotifications    AgentNotification[]
  agentNotificationSettings AgentNotificationSetting[]
  agentPresences        AgentPresence[]
  domainEvents          DomainEvent[]
  backgroundJobs        BackgroundJob[]
  conversationDrafts    ConversationDraft[]
  orcamentos            Orcamento[]
  pedidos               PedidoVenda[]
  vendas                VendaFaturamento[]
  skus                  Sku[]
  balances              InventoryBalance[]
  movements             InventoryMovement[]
  outbox                NotificationOutbox[]
  sessions              Session[]
  automationRules       AutomationRule[]
  macros                Macro[]
  customAttributeDefinitions CustomAttributeDefinition[]
  agentBots             AgentBot[]
  agentBotInboxes       AgentBotInbox[]
  webhooks              Webhook[]
  workingHours          WorkingHour[]
  assignmentPolicies    AssignmentPolicy[]
  csatResponses         CsatResponse[]
  customFilters         CustomFilter[]
  contactImportBatches  ContactImportBatch[]
  campaigns             Campaign[]
  campaignRecipients    CampaignRecipient[]
  portals               Portal[]
  helpCategories        HelpCategory[]
  articles              Article[]
  slaPolicies           SlaPolicy[]
  conversationSlas      ConversationSla[]
  agentCapacities       AgentCapacity[]
  captainAssistants     CaptainAssistant[]
  captainSuggestions    CaptainSuggestion[]
  auditEvents           AuditEvent[]
  samlConfig            SamlConfig?
  mfaDevices            MfaDevice[]
  customRoles           CustomRole[]
  integrationInstalls   IntegrationInstall[]
  dashboardApps         DashboardApp[]

  @@map("tenants")
}

model Theme {
  tenantId   String  @id @map("tenant_id")
  marca      String
  primary    String
  accent     String
  background String
  logoUrl    String? @map("logo_url")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("themes")
}

model User {
  id           String            @id
  email        String            @unique
  passwordHash String            @map("password_hash")
  nome         String
  whatsapp     String?
  ativo        Boolean           @default(true)
  availability AgentAvailability @default(offline)
  signature    String?
  createdAt    DateTime          @default(now()) @map("created_at")

  memberships            Membership[]
  clientes               Cliente[]
  sessions               Session[]
  cadastrosReviewed      CadastroRequest[]         @relation("CadastroReviewer")
  orcamentosAsVendedor   Orcamento[]               @relation("OrcamentoVendedor")
  pedidosAsVendedor      PedidoVenda[]             @relation("PedidoVendedor")
  vendasCreated          VendaFaturamento[]        @relation("VendaCreator")
  movements              InventoryMovement[]
  orcamentoStatusChanges OrcamentoStatusHistory[]
  pedidoStatusChanges    PedidoStatusHistory[]
  vendaStatusChanges     VendaStatusHistory[]
  inboxMembers           InboxMember[]
  teamMembers            TeamMember[]
  assignedConversations  Conversation[]            @relation("ConversationAssignee")
  sentMessages           Message[]                 @relation("MessageSender")
  agentNotifications     AgentNotification[]
  agentNotificationSetting AgentNotificationSetting?
  agentPresences         AgentPresence[]
  conversationDrafts     ConversationDraft[]
  domainEvents           DomainEvent[]             @relation("DomainEventActor")
  automationRulesCreated AutomationRule[]          @relation("AutomationRuleCreator")
  macrosOwned            Macro[]                   @relation("MacroOwner")
  customFilters          CustomFilter[]
  contactImportBatches   ContactImportBatch[]      @relation("ImportBatchCreator")
  assignmentPolicyCursor AssignmentPolicy[]        @relation("AssignmentPolicyCursor")
  csatAssigned           CsatResponse[]            @relation("CsatAssignedAgent")
  campaignsCreated       Campaign[]                @relation("CampaignCreator")
  articlesAuthored       Article[]                 @relation("ArticleAuthor")
  pushSubscriptions      PushSubscription[]
  agentCapacities        AgentCapacity[]
  captainSuggestionsRequested CaptainSuggestion[]  @relation("CaptainSuggestionActor")
  captainSuggestionsResolved  CaptainSuggestion[]  @relation("CaptainSuggestionResolver")
  auditEvents            AuditEvent[]              @relation("AuditEventActor")
  mfaDevices             MfaDevice[]
  csatReviewed           CsatResponse[]            @relation("CsatReviewedBy")

  @@map("users")
}

model Membership {
  id           String    @id
  tenantId     String    @map("tenant_id")
  userId       String    @map("user_id")
  saasRole     SaasRole? @map("saas_role")
  isCustomer   Boolean   @default(false) @map("is_customer")
  customRoleId String?   @map("custom_role_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  customRole CustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, userId])
  @@index([tenantId, saasRole])
  @@index([tenantId, customRoleId])
  @@map("memberships")
}

model CadastroRequest {
  id                   String         @id
  tenantId             String         @map("tenant_id")
  cnpjDigits           String         @map("cnpj_digits")
  cnpjLast4            String         @map("cnpj_last4")
  cnpjRegistroPendente Boolean        @default(false) @map("cnpj_registro_pendente")
  razaoSocial          String         @map("razao_social")
  contatoNome          String         @map("contato_nome")
  email                String
  whatsapp             String
  status               CadastroStatus @default(pendente)
  motivoRecusa         String?        @map("motivo_recusa")
  source               CadastroSource
  conversationId       String?        @map("conversation_id")
  contactId            String?        @map("contact_id")
  clienteId            String?        @map("cliente_id")
  reviewedByUserId     String?        @map("reviewed_by_user_id")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  conversation Conversation?    @relation("CadastroConversation", fields: [conversationId], references: [id], onDelete: SetNull)
  contact      Contact?         @relation("CadastroContact", fields: [contactId], references: [id], onDelete: SetNull)
  cliente      Cliente?         @relation("CadastroToCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  reviewedBy   User?            @relation("CadastroReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  clienteOrigin Cliente?        @relation("ClienteFromCadastro")
  orcamentos   Orcamento[]
  outbox       NotificationOutbox[]
  conversationsLinked Conversation[] @relation("ConversationCadastro")
  contactsLinked Contact[] @relation("ContactCadastro")

  @@index([tenantId, status])
  @@index([tenantId, cnpjDigits])
  @@map("cadastro_requests")
}

model Company {
  id                   String   @id
  tenantId             String   @map("tenant_id")
  cnpjDigits           String   @map("cnpj_digits")
  cnpjLast4            String   @map("cnpj_last4")
  cnpjRegistroPendente Boolean  @default(false) @map("cnpj_registro_pendente")
  razaoSocial          String   @map("razao_social")
  nomeFantasia         String?  @map("nome_fantasia")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]
  clientes Cliente[]

  @@unique([tenantId, cnpjDigits])
  @@map("companies")
}

model Contact {
  id                   String   @id
  tenantId             String   @map("tenant_id")
  nome                 String
  email                String?
  phoneE164            String?  @map("phone_e164")
  companyId            String?  @map("company_id")
  clienteId            String?  @map("cliente_id")
  cadastroRequestId    String?  @map("cadastro_request_id")
  notas                String?
  customAttributesJson String   @default("{}") @map("custom_attributes_json")
  mergedIntoId         String?  @map("merged_into_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  cliente         Cliente?         @relation("ContactCliente", fields: [clienteId], references: [id], onDelete: SetNull)
  cadastroRequest CadastroRequest? @relation("ContactCadastro", fields: [cadastroRequestId], references: [id], onDelete: SetNull)
  mergedInto      Contact?         @relation("ContactMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom      Contact[]        @relation("ContactMerge")
  contactInboxes  ContactInbox[]
  conversations   Conversation[]
  labels          ContactLabel[]
  primaryForClientes Cliente[]     @relation("ClientePrimaryContact")
  cadastrosLinked CadastroRequest[] @relation("CadastroContact")
  csatResponses   CsatResponse[]
  campaignRecipients CampaignRecipient[]

  @@index([tenantId, phoneE164])
  @@index([tenantId, email])
  @@index([tenantId, clienteId])
  @@index([tenantId, mergedIntoId])
  @@map("contacts")
}

model ContactInbox {
  id        String   @id
  tenantId  String   @map("tenant_id")
  contactId String   @map("contact_id")
  inboxId   String   @map("inbox_id")
  sourceId  String   @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  inbox   Inbox   @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@unique([tenantId, inboxId, sourceId])
  @@index([tenantId, contactId])
  @@map("contact_inboxes")
}

model Cliente {
  id                   String        @id
  tenantId             String        @map("tenant_id")
  userId               String?       @map("user_id")
  companyId            String?       @map("company_id")
  primaryContactId     String?       @map("primary_contact_id")
  cnpjDigits           String        @map("cnpj_digits")
  cnpjLast4            String        @map("cnpj_last4")
  cnpjRegistroPendente Boolean       @default(false) @map("cnpj_registro_pendente")
  razaoSocial          String        @map("razao_social")
  contatoNome          String        @map("contato_nome")
  email                String
  whatsapp             String
  status               ClienteStatus @default(aprovado)
  cadastroRequestId    String?       @unique @map("cadastro_request_id")
  createdAt            DateTime      @default(now()) @map("created_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  primaryContact  Contact?          @relation("ClientePrimaryContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  cadastroOrigin  CadastroRequest?  @relation("ClienteFromCadastro", fields: [cadastroRequestId], references: [id], onDelete: SetNull)
  cadastros       CadastroRequest[] @relation("CadastroToCliente")
  contacts        Contact[]         @relation("ContactCliente")
  conversations   Conversation[]
  orcamentos      Orcamento[]
  pedidos         PedidoVenda[]

  @@unique([tenantId, cnpjDigits])
  @@index([tenantId, userId])
  @@map("clientes")
}

model Inbox {
  id                               String      @id
  tenantId                         String      @map("tenant_id")
  name                             String
  channelType                      ChannelType @default(whatsapp) @map("channel_type")
  greeting                         String?
  oooMessage                       String?     @map("ooo_message")
  csatEnabled                      Boolean     @default(false) @map("csat_enabled")
  lockToSingleConversation         Boolean     @default(true) @map("lock_to_single_conversation")
  allowAutoAssign                  Boolean     @default(false) @map("allow_auto_assign")
  vendedorSeeAll                   Boolean     @default(false) @map("vendedor_see_all")
  timezone                         String      @default("America/Sao_Paulo")
  defaultSlaPolicyId               String?     @map("default_sla_policy_id")
  requiredAttributeKeysOnResolveJson String    @default("[]") @map("required_attribute_keys_on_resolve_json")
  createdAt                        DateTime    @default(now()) @map("created_at")
  updatedAt                        DateTime    @updatedAt @map("updated_at")

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultSlaPolicy      SlaPolicy?             @relation("InboxDefaultSla", fields: [defaultSlaPolicyId], references: [id], onDelete: SetNull)
  channelWhatsapp       ChannelWhatsapp?
  channelWebsiteWidget  ChannelWebsiteWidget?
  channelEmail          ChannelEmail?
  channelSocial         ChannelSocial?
  channelSms            ChannelSms?
  channelApi            ChannelApi?
  channelVoice          ChannelVoice?
  widgetSessions        WidgetSession[]
  members               InboxMember[]
  conversations         Conversation[]
  contactInboxes        ContactInbox[]
  workingHours          WorkingHour[]
  assignmentPolicy      AssignmentPolicy?
  agentBotInboxes       AgentBotInbox[]
  webhooks              Webhook[]
  csatResponses         CsatResponse[]
  campaigns             Campaign[]

  @@index([tenantId, channelType])
  @@index([tenantId, defaultSlaPolicyId])
  @@map("inboxes")
}

model ChannelWhatsapp {
  id                 String             @id
  tenantId           String             @map("tenant_id")
  inboxId            String             @unique @map("inbox_id")
  provider           WaProvider         @default(whatsapp_cloud)
  phoneE164Display   String?            @map("phone_e164_display")
  phoneNumberId      String?            @map("phone_number_id")
  businessAccountId  String?            @map("business_account_id")
  secretsCiphertext  String?            @map("secrets_ciphertext")
  connectionStatus   WaConnectionStatus @default(not_configured) @map("connection_status")
  messageTemplatesJson String           @default("[]") @map("message_templates_json")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("channel_whatsapp")
}

model ChannelWebsiteWidget {
  id                     String             @id
  tenantId               String             @map("tenant_id")
  inboxId                String             @unique @map("inbox_id")
  websiteToken           String             @unique @map("website_token")
  hmacSecretCiphertext   String?            @map("hmac_secret_ciphertext")
  allowedOriginsJson     String             @default("[]") @map("allowed_origins_json")
  preChatFieldsJson      String             @default("[]") @map("pre_chat_fields_json")
  welcomeTitle           String?            @map("welcome_title")
  widgetColor            String?            @map("widget_color")
  continuity             String             @default("session")
  connectionStatus       WaConnectionStatus @default(not_configured) @map("connection_status")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("channel_website_widgets")
}

model WidgetSession {
  id                String    @id
  tenantId          String    @map("tenant_id")
  inboxId           String    @map("inbox_id")
  websiteToken      String    @map("website_token")
  sessionTokenHash  String    @map("session_token_hash")
  contactId         String?   @map("contact_id")
  conversationId    String?   @map("conversation_id")
  preChatJson       String?   @map("pre_chat_json")
  expiresAt         DateTime  @map("expires_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sessionTokenHash])
  @@index([inboxId, contactId])
  @@index([websiteToken])
  @@map("widget_sessions")
}

model ChannelEmail {
  id                 String             @id
  tenantId           String             @map("tenant_id")
  inboxId            String             @unique @map("inbox_id")
  provider           String             @default("smtp_imap")
  forwardToEmail     String?            @map("forward_to_email")
  fromEmailDisplay   String?            @map("from_email_display")
  secretsCiphertext  String?            @map("secrets_ciphertext")
  connectionStatus   WaConnectionStatus @default(not_configured) @map("connection_status")
  emailTemplateId    String?            @map("email_template_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox         Inbox          @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  emailTemplate EmailTemplate? @relation(fields: [emailTemplateId], references: [id], onDelete: SetNull)

  @@map("channel_email")
}

model ChannelSocial {
  id                   String             @id
  tenantId             String             @map("tenant_id")
  inboxId              String             @unique @map("inbox_id")
  provider             String
  externalPageOrBotId  String?            @map("external_page_or_bot_id")
  secretsCiphertext    String?            @map("secrets_ciphertext")
  connectionStatus     WaConnectionStatus @default(not_configured) @map("connection_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("channel_social")
}

model ChannelSms {
  id                 String             @id
  tenantId           String             @map("tenant_id")
  inboxId            String             @unique @map("inbox_id")
  provider           String             @default("twilio")
  fromNumberDisplay  String?            @map("from_number_display")
  secretsCiphertext  String?            @map("secrets_ciphertext")
  connectionStatus   WaConnectionStatus @default(not_configured) @map("connection_status")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@map("channel_sms")
}

model ChannelApi {
  id                   String             @id
  tenantId             String             @map("tenant_id")
  inboxId              String             @unique @map("inbox_id")
  apiAccessTokenHash   String?            @unique @map("api_access_token_hash")
  tokenPrefix          String?            @map("token_prefix")
  tokenLast4           String?            @map("token_last4")
  callbackUrl          String?            @map("callback_url")
  connectionStatus     WaConnectionStatus @default(not_configured) @map("connection_status")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("channel_api")
}

model ChannelVoice {
  id                String             @id
  tenantId          String             @map("tenant_id")
  inboxId           String             @unique @map("inbox_id")
  provider          String             @default("twilio_voice")
  secretsCiphertext String?            @map("secrets_ciphertext")
  connectionStatus  WaConnectionStatus @default(not_configured) @map("connection_status")
  metadataJson      String?            @map("metadata_json")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inbox  Inbox  @relation(fields: [inboxId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("channel_voice")
}

model EmailTemplate {
  id                String   @id
  tenantId          String   @map("tenant_id")
  name              String
  slug              String
  subjectTemplate   String   @map("subject_template")
  bodyHtmlTemplate  String   @map("body_html_template")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channelEmails  ChannelEmail[]

  @@unique([tenantId, slug])
  @@map("email_templates")
}

model PushSubscription {
  id        String   @id
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

