# Local MVP — copy to .env. Never commit real secrets.
# Path is relative to prisma/schema.prisma (→ prisma/dev.db).
DATABASE_URL="file:./dev.db"
SESSION_SECRET="dev-only-change-me-not-for-production"
NEXT_PUBLIC_DEFAULT_TENANT_SLUG="casa-dos-frios"
CNPJ_REGISTRY_ENABLED="false"
# Documentação / legado: envio live é controlado por connection_status=live na caixa WA
WHATSAPP_INBOX_MODE="simulate"
# 32-byte key, base64-encoded — AES-256-GCM for WA channel secrets (dev placeholder only)
CREDENTIALS_ENCRYPTION_KEY="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
# Origem pública (sem barra final) — monta a URL do webhook na UI de Caixas
# Ex. QA: https://test3.lecrunch.com.br
PUBLIC_APP_URL="http://localhost:3000"
# Alias opcional de PUBLIC_APP_URL
# WEBHOOK_BASE_URL="http://localhost:3000"
# Só para testes — não definir em produção (padrão: https://graph.facebook.com/v21.0)
# META_GRAPH_API_BASE_URL=""
