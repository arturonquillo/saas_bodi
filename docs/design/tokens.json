{
  "version": 2,
  "meta": {
    "locale": "pt-BR",
    "brand": "Casa dos Frios",
    "notes": "Loja and SaaS consume tenant tokens. Account out of MVP. Tenant-editable: marca, primary, accent, background, logo. System owns Archivo + IBM Plex Sans, radius, spacing, status colors, elevation, motion. Visual: docs/design/visual.md."
  },
  "surfaces": {
